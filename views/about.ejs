<%- include("partials/head", { title: "About | Food Fiesta" }) %>

<link rel="stylesheet" href="/css/about.css">

</head>

<body>

<%- include("partials/navbar") %>

<!-- =======================================
            ABOUT HERO
======================================= -->

<section class="about-hero">

    <div class="overlay"></div>

    <div class="container">

        <div class="hero-content">

            <h1>About Food Fiesta</h1>

            <p>

                Bringing people together through unforgettable food,
                warm hospitality and premium dining experiences.

            </p>

        </div>

    </div>

</section>


<!-- =======================================
            OUR STORY
======================================= -->

<section class="our-story">

    <div class="container">

        <div class="row align-items-center">

            <!-- Image -->

            <div class="col-lg-6">

                <div class="story-image">

                    <img src="/images/about/about-story.jpg" alt="Our Story">

                </div>

            </div>

            <!-- Content -->

            <div class="col-lg-6">

                <span class="section-subtitle">

                    OUR STORY

                </span>

                <h2 class="section-title">

                    Passion For Great Food Since 2010

                </h2>

                <p class="story-text">

                    Food Fiesta was founded with one simple goal —
                    to create unforgettable dining experiences through
                    authentic recipes, premium ingredients and exceptional
                    hospitality.

                </p>

                <p class="story-text">

                    Every dish we prepare is crafted with love by our
                    experienced chefs to ensure every customer leaves
                    with a smile.

                </p>

                <a href="/menu" class="story-btn">

                    Explore Menu

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =======================================
        MISSION & VISION
======================================= -->

<section class="mission-section">

    <div class="container">

        <div class="row g-4">

            <div class="col-lg-6">

                <div class="mission-card">

                    <i class="fas fa-bullseye"></i>

                    <h3>Our Mission</h3>

                    <p>

                        To serve fresh, delicious food while creating
                        memorable dining experiences for every guest.

                    </p>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="mission-card">

                    <i class="fas fa-eye"></i>

                    <h3>Our Vision</h3>

                    <p>

                        To become India's most loved premium restaurant
                        by combining taste, innovation and hospitality.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =======================================
        MASTER CHEFS
======================================= -->

<section class="chef-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-subtitle">

                OUR TEAM

            </span>

            <h2 class="section-title">

                Meet Our Master Chefs

            </h2>

        </div>

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="chef-card">

                    <img src="/images/chefs/chef3.jpg">

                    <h4>Chef Olivia</h4>

                    <p>Executive Chef</p>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="chef-card">

                    <img src="/images/chefs/chef2.jpg">

                    <h4>Chef William</h4>

                    <p>Italian Cuisine</p>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="chef-card">

                    <img src="/images/chefs/chef1.jpg">

                    <h4>Chef Daniel</h4>

                    <p>Dessert Specialist</p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =======================================
        CTA
======================================= -->

<section class="about-cta">

    <div class="container">

        <h2>

            Experience Premium Dining Today

        </h2>

        <p>

            Reserve your table now and enjoy unforgettable flavours.

        </p>

        <a href="/reservation" class="cta-btn">

            Book Now

        </a>

    </div>

</section>

<%- include("partials/footer") %>

<script src="/js/about.js"></script>

<%- include("partials/scripts") %>