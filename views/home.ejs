<%- include("partials/head", { title: "Home | Food Fiesta" }) %>

<link rel="stylesheet" href="/css/home.css">

</head>

<body>

<%- include("partials/navbar") %>

<!-- HERO SECTION -->

<section class="hero">

    <div class="hero-overlay"></div>

    <div class="container hero-content">

        <div class="premium-badge">
            ⭐ PREMIUM DINING SINCE 2010
        </div>

        <h1 class="hero-title">
            Where Every Bite
            <span>Tells a Story</span>
        </h1>

        <p class="hero-description">

            Authentic flavors from six continents, crafted with passion by our
            award-winning culinary team. Your table awaits.

        </p>

        <div class="hero-buttons">

            <a href="/menu" class="btn btn-primary-custom">
                Explore Menu
            </a>

            <a href="/reservation" class="btn btn-secondary-custom">
                Book a Table
            </a>

        </div>

        <div class="scroll-text">

            SCROLL

            <br>

            <i class="fas fa-chevron-down"></i>

        </div>

    </div>

</section>

<!-- ================= STATS SECTION ================= -->

<section class="stats">

    <div class="container">

        <div class="row justify-content-center g-4">

            <div class="col-auto">

                <div class="stat-box">

                    <h2>15+</h2>

                    <p>Years of Excellence</p>

                </div>

            </div>

            <div class="col-auto">

                <div class="stat-box">

                    <h2>50+</h2>

                    <p>Signature Dishes</p>

                </div>

            </div>

            <div class="col-auto">

                <div class="stat-box">

                    <h2>1000+</h2>

                    <p>Happy Customers</p>

                </div>

            </div>

            <div class="col-auto">

                <div class="stat-box">

                    <h2>25+</h2>

                    <p>Professional Chefs</p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ==========================
        ABOUT SECTION
========================== -->

<section class="about-section">

    <div class="container">

        <div class="row align-items-center gy-5">

            <!-- Left Images -->

            <div class="col-lg-6">

                <div class="about-images">

                    <img src="/images/about/about-main.jpg"
                        class="about-main"
                        alt="Restaurant">

                    <img src="/images/about/about-small.jpg"
                        class="about-small"
                        alt="Chef">

                </div>

            </div>

            <!-- Right Content -->

            <div class="col-lg-6">

                <span class="about-subtitle">
                    ABOUT FOOD FIESTA
                </span>

                <h2 class="about-title">
                    A Culinary Journey Since 2010
                </h2>

                <p class="about-text">

                    At Food Fiesta, every dish tells a story. We combine
                    fresh ingredients, authentic recipes, and world-class
                    hospitality to create unforgettable dining experiences.

                </p>

                <div class="about-features">

                    <div class="feature-item">
                        ✓ Fresh Ingredients
                    </div>

                    <div class="feature-item">
                        ✓ Award Winning Chefs
                    </div>

                    <div class="feature-item">
                        ✓ Luxury Dining Experience
                    </div>

                    <div class="feature-item">
                        ✓ Cozy Ambience
                    </div>

                    <div class="feature-item">
                        ✓ Online Reservation
                    </div>

                    <div class="feature-item">
                        ✓ Fast Service
                    </div>

                </div>

                    <div class="about-buttons">

              <a href="/about" class="btn-story">
            Discover Our Story
              </a>

             </div>

            </div>

        </div>

    </div>

</section>

<!-- ==========================
        POPULAR DISHES
========================== -->

<section class="popular-dishes">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-subtitle">
                OUR MENU
            </span>

            <h2 class="section-title">
                Popular Dishes
            </h2>

            <p class="section-description">
                Discover our chef's signature creations made with fresh ingredients
                and authentic flavours.
            </p>

        </div>

        <div class="row g-4">

            <% menuItems.forEach(item => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="food-card">

                        <div class="food-image">

                            <img src="<%= item.image %>"
                                alt="<%= item.name %>">

                            <span class="popular-tag">
                                Popular
                            </span>

                            <button class="wishlist-btn">

                                <i class="fa-regular fa-heart"></i>

                            </button>

                        </div>

                        <div class="food-content">

                            <div class="food-rating">

                                ⭐⭐⭐⭐⭐

                                <span>(4.9)</span>

                            </div>

                            <h3>

                                <%= item.name %>

                            </h3>

                            <p>

                                <%= item.description %>

                            </p>

                            <div class="food-footer">

                                <h4>

                                    ₹<%= item.price %>

                                </h4>

                                <button
                                    class="cart-btn add-to-cart"
                                    data-id="<%= item._id %>"
                                    data-name="<%= item.name %>"
                                    data-price="<%= item.price %>"
                                    data-image="<%= item.image %>">

                                    + Add

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

        <div class="text-center mt-5">

            <a href="/menu" class="view-menu-btn">

                View Complete Menu

            </a>

        </div>

    </div>

</section>


<!-- ==========================
        WHY CHOOSE US
========================== -->

<section class="why-us">

    <div class="container">

        <div class="row align-items-center">

            <!-- Left -->

            <div class="col-lg-6">

                <span class="section-subtitle">

                    WHY CHOOSE US

                </span>

                <h2 class="section-title">

                    We Don't Just Serve Food,

                    <br>

                    We Create Memories

                </h2>

                <p class="section-description">

                    Every dish is crafted using premium ingredients,
                    authentic recipes and a passion for creating unforgettable
                    dining experiences.

                </p>

                <div class="why-list">

                    <div class="why-box">

                        <div class="why-icon">

                            <i class="fa-solid fa-seedling"></i>

                        </div>

                        <div>

                            <h5>

                                Fresh Ingredients

                            </h5>

                            <p>

                                Farm fresh vegetables and premium quality ingredients.

                            </p>

                        </div>

                    </div>

                    <div class="why-box">

                        <div class="why-icon">

                            <i class="fa-solid fa-user-chef"></i>

                        </div>

                        <div>

                            <h5>

                                Expert Chefs

                            </h5>

                            <p>

                                Passionate chefs with years of culinary excellence.

                            </p>

                        </div>

                    </div>

                    <div class="why-box">

                        <div class="why-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <div>

                            <h5>

                                Fast Service

                            </h5>

                            <p>

                                Freshly prepared meals served quickly.

                            </p>

                        </div>

                    </div>

                    <div class="why-box">

                        <div class="why-icon">

                            <i class="fa-solid fa-medal"></i>

                        </div>

                        <div>

                            <h5>

                                Premium Quality

                            </h5>

                            <p>

                                Award-winning taste with exceptional hospitality.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Right -->

            <div class="col-lg-6">

                <div class="why-image">

                    <img src="/images/about/whyUs.jpg"

                        alt="Restaurant">

                    <div class="experience-card">

                        <h2>

                            15+

                        </h2>

                        <p>

                            Years Of Excellence

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ==========================
        SPECIAL OFFERS
========================== -->

<section class="offers-section">

    <div class="container">
        
        
        <div class="offer-card">

            <div class="row align-items-center">

                <!-- Left Image -->

                <div class="col-lg-6">

                    <div class="offer-image">

                        <img src="/images/offers/offer-pizza.jpg"
                             alt="Special Offer">

                    </div>

                </div>

                <!-- Right Content -->

                <div class="col-lg-6">

                    <span class="offer-tag">
                        🔥 LIMITED TIME OFFER
                    </span>

                    <h2 class="offer-title">
                        Get Flat
                        <span>30% OFF</span>
                        On Your First Order
                    </h2>

                    <p class="offer-description">

                        Enjoy our signature dishes made with fresh ingredients.
                        Order today and experience premium dining at an amazing
                        discounted price.

                    </p>

                    <ul class="offer-list">

                        <li>
                            <i class="fa-solid fa-circle-check"></i>

                            Premium Quality Food
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>

                            Free Home Delivery
                        </li>

                        <li>
                            <i class="fa-solid fa-circle-check"></i>

                            Fresh Ingredients
                        </li>

                    </ul>

                    <a href="/menu" class="offer-btn">

                        Order Now

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ==========================
        CALL TO ACTION
========================== -->

<section class="cta-section">

    <div class="cta-box">

        <div class="container">

            <span class="cta-subtitle">
                RESERVE YOUR TABLE
            </span>

            <h2 class="cta-title">
                Ready For An Amazing Dining Experience?
            </h2>

            <p class="cta-description">
                Book your table today and enjoy delicious food,
                premium ambience, and unforgettable moments with
                your loved ones.
            </p>

            <a href="/reservation" class="cta-btn">
                Book A Table
            </a>

        </div>

    </div>

</section>


<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/cart.js"></script>

<script src="/js/home.js"></script>

<%- include("partials/scripts") %>