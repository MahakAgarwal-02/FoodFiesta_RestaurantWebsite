<%- include("partials/head",{title:"Login | Food Fiesta"}) %>

<link rel="stylesheet" href="/css/auth.css">

</head>

<body>

<%- include("partials/navbar") %>

<section class="auth-section">

    <div class="container">

        <!-- Header -->
<div class="auth-header">

    <a href="/" class="auth-logo">

        <img src="/images/logo/logo.png" alt="Food Fiesta">

        <span class="food">Food</span><span class="fiesta">Fiesta</span>

    </a>

    <h1>Welcome Back</h1>

    <p>Sign in to your Food Fiesta account</p>

</div>

        <!-- Login Card -->

        <div class="auth-card">

            <form id="loginForm">

                <div class="mb-3">

                    <label>Email Address</label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        required>

                </div>

                <div class="mb-4">

                    <label>Password</label>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        placeholder="Enter your password"
                        required>

                </div>

                <button class="auth-btn">

                    Login

                </button>

                <p class="auth-link">

                    Don't have an account?

                    <a href="/signup">Sign Up</a>

                </p>

            </form>

        </div>

    </div>

</section>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/login.js"></script>

<%- include("partials/scripts") %>