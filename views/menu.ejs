<%- include("partials/head", { title: "Menu | Food Fiesta" }) %>

<link rel="stylesheet" href="/css/menu.css">

</head>

<body>

<%- include("partials/navbar") %>

<!-- ==========================
        MENU HERO
========================== -->

<section class="menu-hero">

    <div class="overlay"></div>

    <div class="container-fluid px-5">

        <div class="menu-hero-content">

            <span class="hero-subtitle">
                OUR MENU
            </span>

            <h1>
                Discover Our Delicious Dishes
            </h1>

            <p>
                Explore a wide variety of freshly prepared dishes made with premium ingredients and unforgettable flavours.
            </p>

        </div>

    </div>

</section>

<!-- ==========================
        MENU SECTION
========================== -->

<section class="menu-section">

    <div class="container">

        <!-- Search -->

        <div class="search-box">

            <input
                type="text"
                id="searchInput"
                placeholder="Search your favourite dish...">

        </div>

        <!-- Categories -->

        <div class="category-buttons">

            <button class="active" data-category="All">All</button>

            <button data-category="Pizza">Pizza</button>

            <button data-category="Burger">Burger</button>

            <button data-category="Pasta">Pasta</button>

            <button data-category="Biryani">Biryani</button>

            <button data-category="Starters">Starters</button>

            <button data-category="Beverages">Beverages</button>

            <button data-category="Desserts">Desserts</button>

        </div>

        <!-- Cards -->

        <div class="row g-4" id="menuContainer">

            <% menuItems.forEach(item=>{ %>

            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-12 menu-item" data-category="<%= item.category %>">

                <div class="menu-card">

                    <img src="<%= item.image %>" alt="<%= item.name %>">

                    <div class="menu-content">

                        <span class="badge-category">
                            <%= item.category %>
                        </span>

                        <h3>
                            <%= item.name %>
                        </h3>

                        <p>
                            <%= item.description %>
                        </p>

                        <div class="menu-footer">

                            <h4>
                                ₹<%= item.price %>
                            </h4>

                         <button
                            class="add-btn add-to-cart"
                            data-id="<%= item._id %>"
                            data-name="<%= item.name %>"
                            data-price="<%= item.price %>"
                            data-image="<%= item.image %>">

                            Add to Cart

                        </button>

                        </div>

                    </div>

                </div>

            </div>

            <% }) %>

        </div>

    </div>

</section>


<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/cart.js"></script>

<script src="/js/menu.js"></script>

<%- include("partials/scripts") %>