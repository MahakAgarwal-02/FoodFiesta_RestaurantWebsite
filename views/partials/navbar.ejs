<header>
    <nav class="navbar navbar-expand-lg fixed-top custom-navbar">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand fw-bold logo" href="/">
                <img src="/images/logo/logo.png" alt="Food Fiesta" class="logo-img">
                <span>Food<span class="text-warning">Fiesta</span></span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0 shadow-none" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">

                <i class="fas fa-bars text-white"></i>

            </button>

            <!-- Links -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
    <a class="nav-link <%= activePage === 'home' ? 'active' : '' %>" href="/">
        Home
    </a>
</li>

<li class="nav-item">
    <a class="nav-link <%= activePage === 'about' ? 'active' : '' %>" href="/about">
        About
    </a>
</li>

<li class="nav-item">
    <a class="nav-link <%= activePage === 'menu' ? 'active' : '' %>" href="/menu">
        Menu
    </a>
</li>

<li class="nav-item">
    <a class="nav-link <%= activePage === 'reservation' ? 'active' : '' %>" href="/reservation">
        Reservation
    </a>
</li>

<li class="nav-item">
    <a class="nav-link <%= activePage === 'contact' ? 'active' : '' %>" href="/contact">
        Contact
    </a>
</li>

                </ul>

                <div class="d-flex align-items-center nav-right">

    <a href="/cart" class="cart-icon me-3">

        <i class="fas fa-shopping-cart"></i>

        <span id="cartCount" class="cart-count">0</span>

    </a>

    <% if(user){ %>

        <span class="user-name me-3">

            <i class="fas fa-user-circle"></i>

            Hi, <%= user.name %>

        </span>

        <a href="/logout" class="btn-signup">

            Logout

        </a>

    <% } else { %>

        <a href="/login" class="btn-login me-2">

            Login

        </a>

        <a href="/signup" class="btn-signup">

            Sign Up

        </a>

    <% } %>

</div>

            </div>

        </div>
    </nav>
</header>