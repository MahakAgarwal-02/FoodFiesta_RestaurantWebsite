<%- include("partials/head",{title:"Signup | Food Fiesta"}) %>

<link rel="stylesheet" href="/css/auth.css">

</head>

<body>

<%- include("partials/navbar") %>

<section class="auth-section">

    <div class="container">

        <!-- Header -->

        <div class="auth-header">

    <a href="/" class="auth-logo">

        <img src="/images/logo/logo.png" alt="Food Fiesta">

        <span class="food">Food</span>
        <span class="fiesta">Fiesta</span>

    </a>

    <h1>Join Food Fiesta</h1>

    <p>Create your account to unlock exclusive perks</p>

</div>

        <!-- Signup Card -->

        <div class="auth-card">

            <form id="signupForm">

                <div class="mb-3">

                    <label>Full Name</label>

                    <input
                        type="text"
                        name="name"
                        class="form-control"
                        placeholder="Enter your full name"
                        required>

                </div>

                <div class="mb-3">

                    <label>Email Address</label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        required>

                </div>

                <div class="mb-3">

                    <label>Password</label>

                    <input
                        type="password"
                        name="password"
                        class="form-control"
                        placeholder="Create a password"
                        required>

                </div>

                <div class="mb-4">

                    <label>Confirm Password</label>

                    <input
                        type="password"
                        name="confirmPassword"
                        class="form-control"
                        placeholder="Confirm your password"
                        required>

                </div>

                <button class="auth-btn">

                    Create Account

                </button>

                <p class="auth-link">

                    Already have an account?

                    <a href="/login">Login</a>

                </p>

            </form>

        </div>

    </div>

</section>

<%- include("partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/js/signup.js"></script>

<%- include("partials/scripts") %>